{
  "general": {
    "description": "基础设置",
    "type": "object",
    "hint": "首次使用只需确认启用状态、管理员信息和单条消息长度；其余设置保留默认值即可。",
    "items": {
      "enabled": {
        "description": "启用插件",
        "type": "bool",
        "default": true,
        "hint": "关闭后不注入协议、不拦截回复，也不学习黑话。"
      },
      "default_rule_enabled": {
        "description": "注入默认 Rule",
        "type": "bool",
        "default": true,
        "hint": "每轮临时注入聊天场景、管理员和表达边界。"
      },
      "admin_name": {
        "description": "管理员称谓",
        "type": "string",
        "default": "管理员",
        "hint": "仅用于可信 Rule 展示。"
      },
      "admin_qq_ids": {
        "description": "管理员 QQ 号",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "每行一个 QQ 号。只有这里配置的值会被写入临时 Rule。"
      },
      "max_message_chars": {
        "description": "普通发言单条字数",
        "type": "int",
        "default": 10,
        "minimum": 1,
        "maximum": 200,
        "slider": {
          "min": 1,
          "max": 200,
          "step": 1
        },
        "hint": "普通发言每条不得超过此字数，超出时要求另起一条消息。代码和格式化文本不受此限制。"
      },
      "message_interval_seconds": {
        "description": "多条消息发送间隔（秒）",
        "type": "float",
        "default": 0.8,
        "minimum": 0.0,
        "maximum": 10.0,
        "slider": {
          "min": 0.0,
          "max": 10.0,
          "step": 0.1
        },
        "hint": "同一次回复拆成多条时，首条立即发送，后续每条等待该时长；设为 0 可关闭间隔。"
      }
    }
  },
  "reply_control": {
    "description": "回复控制与黑话",
    "type": "object",
    "hint": "默认配置已经适合日常聊天。关闭回复控制后，协议和黑话学习相关项不会生效。",
    "items": {
      "protocol_enabled": {
        "description": "启用回复控制协议",
        "type": "bool",
        "default": true,
        "hint": "要求最终文本带轻量 <Action> 标签控制头；控制头会被移除，用户只看到普通正文。"
      },
      "protocol_injection_mode": {
        "description": "协议注入位置",
        "type": "string",
        "default": "user",
        "options": [
          "user",
          "both"
        ],
        "labels": [
          "仅用户消息（推荐）",
          "用户消息 + System"
        ],
        "condition": {
          "protocol_enabled": true
        },
        "hint": "日常使用选“仅用户消息”；仅在模型经常忽略协议时再加入 System。"
      },
      "no_reply_enabled": {
        "description": "允许不回复",
        "type": "bool",
        "default": true,
        "condition": {
          "protocol_enabled": true
        },
        "hint": "允许 LLM 在不适合插话时选择 No Reply；不回复原因会记录在上下文追踪页。"
      },
      "max_messages_per_reply": {
        "description": "单次回复消息条数上限",
        "type": "int",
        "default": 5,
        "minimum": 1,
        "maximum": 20,
        "condition": {
          "protocol_enabled": true
        },
        "hint": "一次回复最多拆成多少条 Message 发送；超出时只保留前 N 条并记录日志。"
      },
      "jargon_enabled": {
        "description": "启用黑话学习",
        "type": "bool",
        "default": true,
        "condition": {
          "protocol_enabled": true
        },
        "hint": "从合法 <UnknownTerms> 标签内的 JSON 中记录候选词。"
      },
      "protocol_repair_retry_enabled": {
        "description": "协议控制头修复重试",
        "type": "bool",
        "default": true,
        "condition": {
          "protocol_enabled": true
        },
        "collapsed": true,
        "hint": "首次控制头非法时最多额外调用模型一次，只修复标签控制头；原回复正文不会交给模型重写。"
      },
      "protocol_log_retention_days": {
        "description": "协议日志保留天数",
        "type": "int",
        "default": 7,
        "minimum": 1,
        "maximum": 365,
        "slider": {
          "min": 1,
          "max": 365,
          "step": 1
        },
        "condition": {
          "protocol_enabled": true
        },
        "collapsed": true
      },
      "min_confidence_for_injection": {
        "description": "黑话注入置信度阈值",
        "type": "float",
        "default": 0.75,
        "minimum": 0.0,
        "maximum": 1.0,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.01
        },
        "condition": {
          "protocol_enabled": true,
          "jargon_enabled": true
        },
        "collapsed": true
      },
      "max_injected_jargons": {
        "description": "单次最多注入词条",
        "type": "int",
        "default": 5,
        "minimum": 0,
        "maximum": 50,
        "slider": {
          "min": 0,
          "max": 50,
          "step": 1
        },
        "condition": {
          "protocol_enabled": true,
          "jargon_enabled": true
        },
        "collapsed": true
      },
      "max_injection_tokens": {
        "description": "黑话注入 Token 预算",
        "type": "int",
        "default": 256,
        "minimum": 0,
        "maximum": 4096,
        "slider": {
          "min": 0,
          "max": 4096,
          "step": 64
        },
        "condition": {
          "protocol_enabled": true,
          "jargon_enabled": true
        },
        "collapsed": true
      },
      "max_evidence_per_entry": {
        "description": "单词条最大证据数",
        "type": "int",
        "default": 20,
        "minimum": 1,
        "maximum": 500,
        "slider": {
          "min": 1,
          "max": 500,
          "step": 1
        },
        "condition": {
          "protocol_enabled": true,
          "jargon_enabled": true
        },
        "collapsed": true
      }
    }
  },
  "memory": {
    "description": "长期记忆",
    "type": "object",
    "hint": "OpenViking workspace 由插件内置管理。Provider 全部可选；未选择时仍保留不依赖本地模型的保守能力。",
    "items": {
      "memory_enabled": {
        "description": "启用内置长期记忆",
        "type": "bool",
        "default": true,
        "hint": "使用内置 OpenViking workspace 保存聊天记忆，humanize.db 仅保存任务、回复样例和审计；不启动独立服务、不安装本地模型。"
      },
      "memory_auto_extract_enabled": {
        "description": "自动提取聊天记忆",
        "type": "bool",
        "default": true,
        "condition": {
          "memory_enabled": true
        },
        "hint": "仅在最终消息成功发送后创建后台任务。未选择提取 Provider 时只执行保守规则，不会偷偷调用聊天模型。"
      },
      "memory_extraction_provider_id": {
        "description": "记忆提取 Provider",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "condition": {
          "memory_enabled": true,
          "memory_auto_extract_enabled": true
        },
        "hint": "可选。选择 AstrBot 中已有的 Chat Provider；留空时只保留规则提取，不会下载或加载本地模型。"
      },
      "memory_embedding_provider_id": {
        "description": "记忆向量 Provider",
        "type": "string",
        "default": "",
        "_special": "select_provider:embedding",
        "condition": {
          "memory_enabled": true
        },
        "hint": "可选。选择已有的 Embedding Provider 后，为 OpenViking 召回和回复样例启用向量检索；不会安装本地模型。"
      },
      "memory_rerank_provider_id": {
        "description": "记忆重排 Provider",
        "type": "string",
        "default": "",
        "_special": "select_provider:rerank",
        "condition": {
          "memory_enabled": true
        },
        "collapsed": true,
        "hint": "可选且默认关闭。选择已有的 Rerank Provider 后会参与召回排序；失败时保留原排序。"
      },
      "memory_identity_secret_env": {
        "description": "记忆身份 HMAC 环境变量",
        "type": "string",
        "default": "HUMANIZE_MEMORY_SECRET",
        "condition": {
          "memory_enabled": true
        },
        "collapsed": true,
        "hint": "可选。未设置时插件会在数据目录生成独立密钥文件；备份 OpenViking workspace 时必须一并备份该密钥。"
      },
      "memory_recall_timeout_seconds": {
        "description": "聊天召回截止时间",
        "type": "float",
        "default": 1.5,
        "minimum": 0.2,
        "maximum": 10.0,
        "slider": {
          "min": 0.2,
          "max": 10.0,
          "step": 0.1
        },
        "condition": {
          "memory_enabled": true
        },
        "collapsed": true,
        "hint": "只限制显式配置的 Embedding 或 Rerank Provider；超时立即降级为 OpenViking 层级和关键词召回。"
      },
      "memory_auto_activate_confidence": {
        "description": "记忆自动生效置信度",
        "type": "float",
        "default": 0.88,
        "minimum": 0.5,
        "maximum": 1.0,
        "slider": {
          "min": 0.5,
          "max": 1.0,
          "step": 0.01
        },
        "condition": {
          "memory_enabled": true
        },
        "collapsed": true,
        "hint": "达到该阈值且具有当前用户原文证据的记忆可直接生效，其余保留为候选。"
      },
      "memory_candidate_min_confidence": {
        "description": "记忆候选最低置信度",
        "type": "float",
        "default": 0.55,
        "minimum": 0.0,
        "maximum": 1.0,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.01
        },
        "condition": {
          "memory_enabled": true
        },
        "collapsed": true
      },
      "memory_recall_limit": {
        "description": "单次记忆召回条数",
        "type": "int",
        "default": 5,
        "minimum": 1,
        "maximum": 20,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        },
        "condition": {
          "memory_enabled": true
        },
        "collapsed": true
      },
      "memory_recall_score_threshold": {
        "description": "记忆召回分数阈值",
        "type": "float",
        "default": 0.2,
        "minimum": 0.0,
        "maximum": 1.0,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.01
        },
        "condition": {
          "memory_enabled": true
        },
        "collapsed": true
      },
      "memory_recall_max_chars": {
        "description": "单次记忆注入字符预算",
        "type": "int",
        "default": 2500,
        "minimum": 256,
        "maximum": 20000,
        "condition": {
          "memory_enabled": true
        },
        "collapsed": true,
        "hint": "记忆只作为临时用户上下文注入，并保持回复协议位于最后。"
      },
      "memory_extract_batch_turns": {
        "description": "记忆提取批次回合数（越大越省 LLM 调用，延迟提取）",
        "type": "int",
        "default": 8,
        "minimum": 1,
        "maximum": 20,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        },
        "condition": {
          "memory_enabled": true,
          "memory_auto_extract_enabled": true
        },
        "collapsed": true,
        "hint": "用于后台任务合并与费用控制，不影响最终回复发送。"
      },
      "memory_extract_idle_seconds": {
        "description": "空闲提取等待秒数",
        "type": "int",
        "default": 180,
        "minimum": 15,
        "maximum": 3600,
        "slider": {
          "min": 15,
          "max": 3600,
          "step": 15
        },
        "condition": {
          "memory_enabled": true,
          "memory_auto_extract_enabled": true
        },
        "collapsed": true
      },
      "memory_job_max_attempts": {
        "description": "记忆任务最大尝试次数",
        "type": "int",
        "default": 5,
        "minimum": 1,
        "maximum": 20,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        },
        "condition": {
          "memory_enabled": true,
          "memory_auto_extract_enabled": true
        },
        "collapsed": true
      },
      "reply_examples": {
        "description": "典型短对话样例",
        "type": "object",
        "condition": {
          "memory_enabled": true
        },
        "hint": "从已审核样例中召回表达风格参考，不会直接复用旧回复。",
        "items": {
          "reply_examples_enabled": {
            "description": "启用典型短对话样例",
            "type": "bool",
            "default": true,
            "hint": "只召回经过审核且启用的样例作为临时表达参考。"
          },
          "reply_examples_limit": {
            "description": "单次最多注入样例数",
            "type": "int",
            "default": 3,
            "minimum": 0,
            "maximum": 10,
            "slider": {
              "min": 0,
              "max": 10,
              "step": 1
            },
            "condition": {
              "reply_examples_enabled": true
            },
            "collapsed": true
          },
          "reply_examples_max_chars": {
            "description": "回复样例注入字符预算",
            "type": "int",
            "default": 2000,
            "minimum": 128,
            "maximum": 20000,
            "condition": {
              "reply_examples_enabled": true
            },
            "collapsed": true
          },
          "reply_examples_min_quality": {
            "description": "回复样例最低质量分",
            "type": "float",
            "default": 0.7,
            "minimum": 0.0,
            "maximum": 1.0,
            "slider": {
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            "condition": {
              "reply_examples_enabled": true
            },
            "collapsed": true
          },
          "reply_examples_recall_score_threshold": {
            "description": "回复样例召回分数阈值",
            "type": "float",
            "default": 0.2,
            "minimum": 0.0,
            "maximum": 1.0,
            "slider": {
              "min": 0.0,
              "max": 1.0,
              "step": 0.01
            },
            "condition": {
              "reply_examples_enabled": true
            },
            "collapsed": true,
            "hint": "词法、向量或重排后的最终分数低于该值时不会注入样例。"
          }
        }
      },
      "image_transcription_provider_id": {
        "description": "图片转述模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "condition": {},
        "collapsed": true,
        "hint": "可选。多模态主模型直读原图；非多模态模型用它转述图片，聊天模型可随时按路径调用读图工具。"
      },
      "image_cache_enabled": {
        "description": "启用图片缓存",
        "type": "bool",
        "default": true,
        "condition": {},
        "collapsed": true,
        "hint": "拦截收到的图片保存到插件数据目录，供后续轮次按路径重读与追踪展示。"
      },
      "image_cache_max_entries": {
        "description": "图片缓存上限",
        "type": "int",
        "default": 100,
        "minimum": 1,
        "maximum": 10000,
        "condition": {
          "image_cache_enabled": true
        },
        "collapsed": true,
        "hint": "缓存最多保存多少张普通图片，超出后按最久未使用清理。"
      },
      "image_cache_max_sticker_entries": {
        "description": "表情包缓存上限",
        "type": "int",
        "default": 500,
        "minimum": 1,
        "maximum": 50000,
        "condition": {
          "image_cache_enabled": true
        },
        "collapsed": true,
        "hint": "表情包长期保留并缓存转述文本，最多保存多少条，超出后按最久未使用清理。"
      }
    }
  },
  "proactive": {
    "description": "主动参与",
    "type": "object",
    "items": {
      "proactive_keywords": {
        "description": "触发关键词",
        "type": "list",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "消息里出现机器人名字或这些词时，跳过等待尽快触发回复。每行一个词。群聊许可与主动模式改在 WebUI 的「群聊策略」页维护。"
      },
      "proactive_window_initial_seconds": {
        "description": "初始触发窗口（秒）",
        "type": "int",
        "default": 10,
        "minimum": 5,
        "maximum": 600,
        "hint": "群里出现新消息后等待多久再触发一次回复；机器人回复后回到 1 秒，沉默则加 10 秒，上限见最长触发窗口。"
      },
      "proactive_window_max_seconds": {
        "description": "最长触发窗口（秒）",
        "type": "int",
        "default": 300,
        "minimum": 30,
        "maximum": 3600,
        "hint": "窗口加长的上限，同时也是主动回复频率的上限。"
      }
    },
    "hint": "在群聊中自然接话：窗口到点后走完整回复流程，说不说由模型按协议决定。未 @ 的聊天会作为旁观记录进入对话历史。"
  }
}